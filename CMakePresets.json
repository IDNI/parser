{
	"version": 8,
	"configurePresets": [
		{
			"name": "_generator-make",
			"hidden": true,
			"generator": "Unix Makefiles"
		},

		{
			"name": "_generator-ninja",
			"hidden": true,
			"generator": "Ninja"
		},

		{
			"name": "_toolchain-gcc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "_toolchain-clang",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			}
		},

		{
			"name": "_toolchain-mingw",
			"hidden": true,
			"toolchainFile": "cmake/mingw-w64-x86_64.cmake"
		},

		{
			"name": "_condition-windows",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},

		{
			"name": "_toolchain-msvc",
			"hidden": true,
			"generator": "Ninja",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64"
				}
			}
		},

		{
			"name": "_toolchain-clang-cl",
			"hidden": true,
			"generator": "Ninja",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-clang-x64"
				}
			}
		},

		{
			"name": "_build_dir-release",
			"hidden": true,

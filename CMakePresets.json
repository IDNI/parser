{
	"version": 8,
	"configurePresets": [
		{
			"name": "_generator-make",
			"hidden": true,
			"generator": "Unix Makefiles"
		},
		{
			"name": "_generator-ninja",
			"hidden": true,
			"generator": "Ninja"
		},
		{
			"name": "_toolchain-gcc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "_toolchain-clang",
			"hidden": true,
			"cacheVariables": {

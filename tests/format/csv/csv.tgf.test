# Tests the csv.tgf grammar, RFC 4180 CSV with comma and CRLF.
#
# field rules:
#   non_escaped: zero or more printable chars except '"', ',', CR, LF.
#   escaped: double-quoted, an interior '"' must be doubled ("").
#
# Grammar defaults (comma, crlf) are used, dialect variants live in the
# sibling csv-lf.tgf.test, csv-tab.tgf.test, csv-tab-lf.tgf.test files
# and require --productions.
#
# @inline field folds a field node into its escaped or non_escaped child,
# @trim DQUOTE, SEP, EOL removes those nodes from the shaped tree, so a
# record's direct children are non_escaped and escaped nodes only.
#
# To run:
#   tgf csv.tgf test csv.tgf.test

# ===========================================================================
# 1  SINGLE FIELD
# ===========================================================================

start : "abc", "1.5", "1e5", "hello world", "'single quotes'", "0", "42".

start > file > record > ^ non_escaped $ : "abc", "1.5", "42".
start > file > record > "abc" : "abc".

# ===========================================================================
# 2  MULTIPLE FIELDS
# ===========================================================================

start : "a,b,c", "1,2,3", "abc,def,ghi".

start > file > record {
	^ non_escaped non_escaped non_escaped $ : "a,b,c".
	^ non_escaped non_escaped non_escaped non_escaped $ : "a,b,c,d".
	^ "a" "b" "c" $ : "a,b,c".
}

# ===========================================================================
# 3  RECORDS AND EOL
# ===========================================================================

# 3a  CRLF-separated records
start : "a,b\r\nc,d", "a,b,c\r\nd,e,f".

start > file > ^ record record $ : "a\r\n1", "a,b\r\nc,d".
start > file > ^ record record $ : "a\r\n1\r\n".

# 3b  three records
start : "1,2,3\r\n4,5,6\r\n7,8,9".

start > file > ^ record record record $ : "1,2,3\r\n4,5,6\r\n7,8,9".

# 3c  a lone LF between records is not the enabled EOL, and is not
# TEXTDATA either, so the record boundary itself is a syntax error.
~start : "a,b\nc,d", "1,2,3\n4,5,6".

# 3d  a lone CR is neither TEXTDATA nor a complete EOL[crlf].
~start : "a\rb".

# ===========================================================================
# 4  ESCAPED FIELDS
# ===========================================================================

# 4a  empty and simple quoted fields
start : "\"\"", "\"a\"", "\"abc\"", "\"hello world\"".

start > file > record > escaped! : "\"\"".
start > file > record > ^ escaped $ : "\"abc\"".
start > file > record > "abc" : "\"abc\"".

# 4b  comma inside quotes survives as a leaf, sep_char folds into it
start : "\"a,b\"", "\"one,two,three\"".

start > file > record > escaped > ^ 'a' ',' 'b' $ : "\"a,b\"".
start > file > record > ^ escaped $ : "\"a,b\"".

# 4c  CR and LF inside quotes: both survive as their own nodes,
# because @trim only trims EOL, not the bare CR/LF nonterminals.
start : "\"line1\nline2\",normal",
        "\"field with \r\n inside\",value".

start > file > record > escaped > ^ 'a' CR 'b' $ : "\"a\rb\"".
start > file > record > escaped > ^ 'a' LF 'b' $ : "\"a\nb\"".
start > file > record > escaped > ^ 'a' CR LF 'b' $ : "\"a\r\nb\"".

# 4d  doubled quote for a literal '"' inside an escaped field, the pair
# survives as its own escaped_quote node between the two text fragments.
start > file > record > escaped > ^ 'b' escaped_quote 'c' $ : "\"b\"\"c\"".
start > file > record > escaped > escaped_quote > '"' : "\"b\"\"c\"".
start > file > record > "b\"c" : "\"b\"\"c\"".

# a quoted separator does not change the record's field count
start > file > record > ^ escaped non_escaped $ : "\"a,b\",c".

start : "\"she said \"\"hi\"\"\"", "\"x\"\"y\"\"z\"".

# 4e  an empty escaped field followed by another field
start > file > record > ^ escaped! non_escaped $ : "\"\",b".

# ===========================================================================
# 5  EMPTY FIELDS
# ===========================================================================

# leading, trailing, middle, all empty
start : "a,,c", ",", ",a", "a,", ",,", ",,,".

start > file > record > ^ non_escaped! non_escaped! $ : ",".
start > file > record > ^ non_escaped non_escaped! $ : "a,".
start > file > record > ^ non_escaped! non_escaped $ : ",a".
start > file > record > ^ non_escaped non_escaped! non_escaped $ : "a,,c".
start > file > record > ^ non_escaped! non_escaped! non_escaped! non_escaped! $ : ",,,".

# an empty file is one record with one empty field, not a childless record
~start > file > record! : "".
start > file > record > ^ non_escaped! $ : "".

# ===========================================================================
# 6  WHITESPACE IS DATA
# ===========================================================================

# leading and trailing spaces stay inside non_escaped, they are not
# trimmed the way DQUOTE/SEP/EOL are.
start > file > record > "  a  " : "  a  ,b".
start > file > record > "  leading" : "  leading".
start > file > record > "trailing  " : "trailing  ".
start > file > record > ^ "  a  " non_escaped $ : "  a  ,b".

# ===========================================================================
# 7  FIELD COUNTS PER RECORD
# ===========================================================================

start > file > record > ^ non_escaped $ : "a".
start > file > record > ^ non_escaped non_escaped $ : "a,b".
start > file > record > ^ non_escaped non_escaped non_escaped $ : "a,b,c".
start > file > record > ^ escaped non_escaped $ : "\"a\",b".
start > file > record > ^ non_escaped escaped $ : "a,\"b\"".

# ===========================================================================
# 8  NODE-TEXT ROWS
# ===========================================================================

start > file > record > "abc" : "abc".
start > file > record > "42" : "42".
start > file > record > escaped > "b" : "\"b\"".
start > file > record > "hello world" : "\"hello world\"".

# ===========================================================================
# 9  LEAF ROWS
# ===========================================================================

# a leaf is childless. only a zero-length field is childless, a field
# with at least one character always has a child of its own.
start > file > record > non_escaped! : "".
start > file > record > escaped! : "\"\"".
~start > file > record > non_escaped! : "a".
~start > file > record > escaped! : "\"a\"".
start > file > record > ^ non_escaped! non_escaped! $ : ",".

# ===========================================================================
# 10  NEGATED SHAPE ROWS
# ===========================================================================

# a record with one field is not a two-field record
~start > file > record > ^ non_escaped non_escaped $ : "a".

# an escaped field is not a non_escaped one
~start > file > record > escaped : "abc".
~start > file > record > non_escaped : "\"abc\"".

# the no_header guard is active by default, so file[header] is not part
# of the active grammar and a header node never appears in a tree.
~start > file > header : "a,b\r\n1,2".

# ===========================================================================
# 11  RAW ROWS (pre-shaping tree)
# ===========================================================================

# field, SEP, EOL and DQUOTE all survive before shaping trims/inlines them.
@raw start > file > record > field > non_escaped : "a".
@raw start > file > record > field > escaped > DQUOTE : "\"a\"".
@raw start >> SEP : "a,b".
@raw start >> EOL : "a\r\nb".
@raw start > file > record > field > escaped > CR : "\"a\r\nb\"".
@raw start > file > record > field > escaped > LF : "\"a\r\nb\"".

# header stays absent even before shaping, the no_header guard excludes
# it from the grammar itself, not only from the shaped tree.
~@raw start >> header : "a,b\r\n1,2".

# ===========================================================================
# 12  REJECTS
# ===========================================================================

# a bare '"' inside a non-escaped field is not TEXTDATA and does not
# open a new field.
~start : "ab\"cd".

# an escaped field that never closes.
~start : "\"abc".

# an escaped field followed directly by more characters, with no SEP
# or EOL in between.
~start : "\"a\"b".

# a lone LF is not the enabled EOL[crlf] and is not TEXTDATA.
~start : "a,b\nc,d".

# tab is excluded from the printable character class, so it is never
# valid TEXTDATA under any dialect, comma included.
~start : "a\tb\r\nc\td".

# ===========================================================================
# 13  REALISTIC EXAMPLES
# ===========================================================================

start : "name,age,city\r\nAlice,30,New York\r\nBob,25,London",
        "a,\"b,c\",d",
        "1,\"\",3".

start > file > ^ record record record $ :
	"name,age,city\r\nAlice,30,New York\r\nBob,25,London".
start > file > record > ^ non_escaped escaped non_escaped $ : "a,\"b,c\",d".

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/IDNI/parser/blob/main/src/format/tgf_api.json/tgf_api.schema.json",
	"title": "tgf JSON API",
	"description": "One line of the tgf JSON API: the hello line, one request, or one response.",
	"oneOf": [
		{
			"$ref": "#/$defs/hello_line"
		},
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/response"
		}
	],
	"$defs": {
		"report": {
			"$ref": "https://github.com/IDNI/parser/blob/main/src/format/json/report.schema.json"
		},
		"ast_node": {
			"$ref": "https://github.com/IDNI/parser/blob/main/src/format/ast.json/ast.schema.json#/$defs/node"
		},
		"id": true,
		"state": {
			"type": "object",
			"properties": {
				"grammar": {
					"type": ["string", "null"]
				},
				"start": {
					"type": "string"
				}
			},
			"required": [
				"grammar",
				"start"
			],
			"additionalProperties": false
		},
		"status": {
			"enum": [
				"ok",
				"error",
				"incomplete",
				"quit"
			]
		},
		"symbol": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
		},
		"option_value": {
			"anyOf": [
				{
					"type": "boolean"
				},
				{
					"enum": [
						"basic",
						"detailed",
						"root-cause"
					]
				},
				{
					"type": "array",
					"items": {
						"$ref": "#/$defs/symbol"
					}
				},
				{
					"type": "array",
					"items": {
						"type": "array",
						"items": {
							"$ref": "#/$defs/symbol"
						}
					}
				}
			]
		},
		"option_name": {
			"enum": [
				"error-verbosity",
				"status",
				"colors",
				"print-ambiguity",
				"print-graphs",
				"print-rules",
				"print-facts",
				"print-terminals",
				"measure-parsing",
				"measure-each-pos",
				"measure-forest",
				"measure-preprocess",
				"gc",
				"debug",
				"auto-disambiguate",
				"trim-terminals",
				"inline-char-classes",
				"derive-char-classes",
				"nodisambig-list",
				"enabled-productions",
				"trim",
				"trim-children",
				"trim-children-terminals",
				"inline"
			]
		},
		"bool_option_name": {
			"enum": [
				"status",
				"colors",
				"print-ambiguity",
				"print-graphs",
				"print-rules",
				"print-facts",
				"print-terminals",
				"measure-parsing",
				"measure-each-pos",
				"measure-forest",
				"measure-preprocess",
				"gc",
				"debug",
				"auto-disambiguate",
				"trim-terminals",
				"inline-char-classes",
				"derive-char-classes"
			]
		},
		"list_option_name": {
			"enum": [
				"nodisambig-list",
				"enabled-productions",
				"trim",
				"trim-children",
				"trim-children-terminals"
			]
		},
		"action_option_name": {
			"enum": [
				"nodisambig-list",
				"enabled-productions",
				"trim",
				"trim-children",
				"trim-children-terminals",
				"inline"
			]
		},
		"symbol_list": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/symbol"
			}
		},
		"treepath_list": {
			"type": "array",
			"items": {
				"type": "array",
				"items": {
					"$ref": "#/$defs/symbol"
				}
			}
		},
		"options": {
			"type": "object",
			"properties": {
				"error-verbosity": {
					"enum": [
						"basic",
						"detailed",
						"root-cause"
					]
				},
				"status": {
					"type": "boolean"
				},
				"colors": {
					"type": "boolean"
				},
				"print-ambiguity": {
					"type": "boolean"
				},
				"print-graphs": {
					"type": "boolean"
				},
				"print-rules": {
					"type": "boolean"
				},
				"print-facts": {
					"type": "boolean"
				},
				"print-terminals": {
					"type": "boolean"
				},
				"measure-parsing": {
					"type": "boolean"
				},
				"measure-each-pos": {
					"type": "boolean"
				},
				"measure-forest": {
					"type": "boolean"
				},
				"measure-preprocess": {
					"type": "boolean"
				},
				"gc": {
					"type": "boolean"
				},
				"debug": {
					"type": "boolean"
				},
				"auto-disambiguate": {
					"type": "boolean"
				},
				"trim-terminals": {
					"type": "boolean"
				},
				"inline-char-classes": {
					"type": "boolean"
				},
				"derive-char-classes": {
					"type": "boolean"
				},
				"nodisambig-list": {
					"$ref": "#/$defs/symbol_list"
				},
				"enabled-productions": {
					"$ref": "#/$defs/symbol_list"
				},
				"trim": {
					"$ref": "#/$defs/symbol_list"
				},
				"trim-children": {
					"$ref": "#/$defs/symbol_list"
				},
				"trim-children-terminals": {
					"$ref": "#/$defs/symbol_list"
				},
				"inline": {
					"$ref": "#/$defs/treepath_list"
				}
			},
			"required": [
				"error-verbosity",
				"status",
				"colors",
				"print-ambiguity",
				"print-graphs",
				"print-rules",
				"print-facts",
				"print-terminals",
				"measure-parsing",
				"measure-each-pos",
				"measure-forest",
				"measure-preprocess",
				"gc",
				"debug",
				"auto-disambiguate",
				"trim-terminals",
				"inline-char-classes",
				"derive-char-classes",
				"nodisambig-list",
				"enabled-productions",
				"trim",
				"trim-children",
				"trim-children-terminals",
				"inline"
			],
			"additionalProperties": false
		},
		"production_id": {
			"type": "object",
			"properties": {
				"index": {
					"type": "integer",
					"minimum": 0
				},
				"head": {
					"type": "integer",
					"minimum": 0
				},
				"body": {
					"type": "array",
					"items": {
						"type": "array",
						"items": {
							"type": [
								"integer",
								"null"
							],
							"minimum": 0
						}
					}
				},
				"guard": {
					"type": [
						"string",
						"null"
					]
				},
				"conjunctive": {
					"type": "boolean"
				}
			},
			"required": [
				"index",
				"head",
				"body",
				"guard",
				"conjunctive"
			],
			"additionalProperties": false
		},
		"production_id_list": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/production_id"
			}
		},
		"production_string_list": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"range": {
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": 0
			},
			"minItems": 2,
			"maxItems": 2
		},
		"ambiguous_alternative": {
			"type": "object",
			"properties": {
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ast_node"
					}
				}
			},
			"required": [
				"children"
			],
			"additionalProperties": false
		},
		"ambiguous_node": {
			"type": "object",
			"properties": {
				"symbol": {
					"type": "string"
				},
				"id": {
					"type": "integer",
					"minimum": 0
				},
				"range": {
					"$ref": "#/$defs/range"
				},
				"alternatives": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ambiguous_alternative"
					}
				}
			},
			"required": [
				"symbol",
				"id",
				"range",
				"alternatives"
			],
			"additionalProperties": false
		},
		"ambiguous": {
			"type": "object",
			"properties": {
				"trees": {
					"type": "integer",
					"minimum": 0
				},
				"nodes": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/ambiguous_node"
					}
				}
			},
			"required": [
				"trees",
				"nodes"
			],
			"additionalProperties": false
		},
		"histogram": {
			"type": "object",
			"properties": {
				"0": {
					"type": "integer",
					"minimum": 0
				},
				"1": {
					"type": "integer",
					"minimum": 0
				},
				"2": {
					"type": "integer",
					"minimum": 0
				},
				"3": {
					"type": "integer",
					"minimum": 0
				},
				"4-7": {
					"type": "integer",
					"minimum": 0
				},
				"8-15": {
					"type": "integer",
					"minimum": 0
				},
				"16-63": {
					"type": "integer",
					"minimum": 0
				},
				"64+": {
					"type": "integer",
					"minimum": 0
				}
			},
			"required": [
				"0",
				"1",
				"2",
				"3",
				"4-7",
				"8-15",
				"16-63",
				"64+"
			],
			"additionalProperties": false
		},
		"hash_group_sample": {
			"type": "object",
			"properties": {
				"value": {
					"type": "string"
				},
				"range": {
					"$ref": "#/$defs/range"
				},
				"left": {
					"type": [
						"string",
						"null"
					]
				},
				"right": {
					"type": [
						"string",
						"null"
					]
				},
				"stored_hash": {
					"type": "string"
				},
				"recomputed_hash": {
					"type": "string"
				}
			},
			"required": [
				"value",
				"range",
				"left",
				"right",
				"stored_hash",
				"recomputed_hash"
			],
			"additionalProperties": false
		},
		"bintree_totals": {
			"type": "object",
			"properties": {
				"get_hits": {
					"type": "integer",
					"minimum": 0
				},
				"get_misses": {
					"type": "integer",
					"minimum": 0
				},
				"geth_calls": {
					"type": "integer",
					"minimum": 0
				},
				"buckets": {
					"type": "integer",
					"minimum": 0
				},
				"entries": {
					"type": "integer",
					"minimum": 0
				},
				"load_factor": {
					"type": "number"
				},
				"max_chain": {
					"type": "integer",
					"minimum": 0
				},
				"mean_chain": {
					"type": "number"
				},
				"distinct_hashes": {
					"type": "integer",
					"minimum": 0
				},
				"largest_group_size": {
					"type": "integer",
					"minimum": 0
				},
				"distinct_values": {
					"type": "integer",
					"minimum": 0
				},
				"distinct_child_pairs": {
					"type": "integer",
					"minimum": 0
				},
				"leaf_count": {
					"type": "integer",
					"minimum": 0
				},
				"stale_hash_count": {
					"type": "integer",
					"minimum": 0
				},
				"largest_group_hash": {
					"type": "string"
				},
				"largest_group_stale_count": {
					"type": "integer",
					"minimum": 0
				},
				"chain_length_histogram": {
					"$ref": "#/$defs/histogram"
				},
				"top_hash_groups": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"size": {
								"type": "integer",
								"minimum": 0
							},
							"triples": {
								"type": "integer",
								"minimum": 0
							}
						},
						"required": [
							"size",
							"triples"
						],
						"additionalProperties": false
					}
				},
				"largest_group_samples": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/hash_group_sample"
					}
				}
			},
			"required": [
				"get_hits",
				"get_misses",
				"geth_calls",
				"buckets",
				"entries",
				"load_factor",
				"max_chain",
				"mean_chain",
				"distinct_hashes",
				"largest_group_size",
				"distinct_values",
				"distinct_child_pairs",
				"leaf_count",
				"stale_hash_count",
				"largest_group_hash",
				"largest_group_stale_count",
				"chain_length_histogram",
				"top_hash_groups",
				"largest_group_samples"
			],
			"additionalProperties": false
		},
		"parse_result": {
			"type": "object",
			"properties": {
				"input": {
					"type": "string"
				},
				"ambiguous": {
					"$ref": "#/$defs/ambiguous"
				},
				"terminals": {
					"type": "string"
				},
				"tml_rules": {
					"type": "string"
				},
				"tml_facts": {
					"type": "string"
				},
				"tree": {
					"$ref": "#/$defs/ast_node"
				}
			},
			"additionalProperties": false
		},
		"repl_grammar_result": {
			"type": "object",
			"properties": {
				"file": {
					"type": "string"
				},
				"source": {
					"type": "string"
				}
			},
			"required": [
				"file",
				"source"
			],
			"additionalProperties": false
		},
		"igrammar_result": {
			"type": "object",
			"properties": {
				"start": {
					"type": "string"
				},
				"productions": {
					"$ref": "#/$defs/production_string_list"
				},
				"production_ids": {
					"$ref": "#/$defs/production_id_list"
				}
			},
			"required": [
				"start",
				"productions",
				"production_ids"
			],
			"additionalProperties": false
		},
		"start_result": {
			"type": "object",
			"properties": {
				"start": {
					"type": "string"
				},
				"changed": {
					"type": "boolean"
				}
			},
			"required": [
				"start",
				"changed"
			],
			"additionalProperties": false
		},
		"unreachable_result": {
			"type": "object",
			"properties": {
				"symbol": {
					"type": "string"
				},
				"productions": {
					"$ref": "#/$defs/production_string_list"
				},
				"production_ids": {
					"$ref": "#/$defs/production_id_list"
				}
			},
			"required": [
				"symbol",
				"productions",
				"production_ids"
			],
			"additionalProperties": false
		},
		"load_result": {
			"type": "object",
			"properties": {
				"grammar": {
					"type": "string"
				},
				"loaded": {
					"type": "boolean"
				}
			},
			"required": [
				"grammar",
				"loaded"
			],
			"additionalProperties": false
		},
		"help_result": {
			"type": "object",
			"properties": {
				"command": {
					"type": "string"
				},
				"text": {
					"type": "string"
				}
			},
			"required": [
				"command",
				"text"
			],
			"additionalProperties": false
		},
		"version_result": {
			"type": "object",
			"properties": {
				"version": {
					"type": "string"
				}
			},
			"required": [
				"version"
			],
			"additionalProperties": false
		},
		"license_result": {
			"type": "object",
			"properties": {
				"license": {
					"type": "string"
				}
			},
			"required": [
				"license"
			],
			"additionalProperties": false
		},
		"empty_result": {
			"type": "object",
			"maxProperties": 0
		},
		"options_result": {
			"type": "object",
			"properties": {
				"options": {
					"$ref": "#/$defs/options"
				}
			},
			"required": [
				"options"
			],
			"additionalProperties": false
		},
		"single_option_result": {
			"type": "object",
			"properties": {
				"option": {
					"$ref": "#/$defs/option_name"
				},
				"value": true
			},
			"required": [
				"option",
				"value"
			],
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"option": {
								"$ref": "#/$defs/bool_option_name"
							}
						},
						"required": [
							"option"
						]
					},
					"then": {
						"properties": {
							"value": {
								"type": "boolean"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"option": {
								"const": "error-verbosity"
							}
						},
						"required": [
							"option"
						]
					},
					"then": {
						"properties": {
							"value": {
								"enum": [
									"basic",
									"detailed",
									"root-cause"
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"option": {
								"$ref": "#/$defs/list_option_name"
							}
						},
						"required": [
							"option"
						]
					},
					"then": {
						"properties": {
							"value": {
								"$ref": "#/$defs/symbol_list"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"option": {
								"const": "inline"
							}
						},
						"required": [
							"option"
						]
					},
					"then": {
						"properties": {
							"value": {
								"$ref": "#/$defs/treepath_list"
							}
						}
					}
				}
			]
		},
		"option_result": {
			"anyOf": [
				{
					"$ref": "#/$defs/single_option_result"
				},
				{
					"$ref": "#/$defs/empty_result"
				}
			]
		},
		"get_result": {
			"anyOf": [
				{
					"$ref": "#/$defs/options_result"
				},
				{
					"$ref": "#/$defs/single_option_result"
				},
				{
					"$ref": "#/$defs/empty_result"
				}
			]
		},
		"nullable_entry": {
			"type": "object",
			"properties": {
				"symbol": {
					"type": "string"
				},
				"id": {
					"type": "integer",
					"minimum": 0
				},
				"index": {
					"type": "integer",
					"minimum": 0
				},
				"production": {
					"type": "string"
				}
			},
			"required": [
				"symbol",
				"id",
				"index",
				"production"
			],
			"additionalProperties": false
		},
		"cli_grammar_result": {
			"type": "object",
			"properties": {
				"start": {
					"type": "string"
				},
				"productions": {
					"$ref": "#/$defs/production_string_list"
				},
				"production_ids": {
					"$ref": "#/$defs/production_id_list"
				},
				"nullable": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/nullable_entry"
					}
				}
			},
			"required": [
				"start",
				"productions",
				"production_ids"
			],
			"additionalProperties": false
		},
		"gen_result": {
			"type": "object",
			"properties": {
				"files": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"required": [
				"files"
			],
			"additionalProperties": false
		},
		"parse_oneshot_result": {
			"type": "object",
			"properties": {
				"input": {
					"type": "string"
				},
				"ambiguous": {
					"$ref": "#/$defs/ambiguous"
				},
				"terminals": {
					"type": "string"
				},
				"tml_rules": {
					"type": "string"
				},
				"tml_facts": {
					"type": "string"
				},
				"tree": {
					"$ref": "#/$defs/ast_node"
				},

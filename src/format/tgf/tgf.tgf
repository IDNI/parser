@use char class eof, alnum, alpha, space, printable, xdigit.

@trim __, _, sep.
@trim all terminals except children of
	sym, dir_sym, cc_name, escaped_s, unescaped_s, escaped_c, unescaped_c,
	terminal_hex, hex_bytes.
@inline char classes, escape_char, esc_hex, esc_u4, esc_U8.

# keyword, operator, string, comment, number, type, variable, delimiter
@highlight
	type    : directive_name, directive_token, directive_cmd;
        operator: alternation, conjunction, optional, repeat, none_or_repeat, neg, tree_path,
                  production > ("=>");
	string  : terminal_string, terminal_char;
	comment : comment;
	number  : escaped_s, escaped_c, terminal_hex;
        keyword : dir_sym;
	variable: sym;
	delimiter: production > ('.'), directive > ('.').

# start symbol
start                  => (_ statement)* _.

statement              => directive | production.
start_statement	       => _ statement _.

# productions
production             => sym [ _ '[' _ sym:production_guard _ ']' ]
                                                    _ "=>" _ alternation _ '.'.
alternation            => conjunction   (_ '|' _ conjunction)*.
conjunction            => concatenation (_ '&' _ concatenation)*. 
concatenation          => factor (__ factor)*.
factor                 => (factor _ ':' sym)       :shorthand_rule
                        | (term '?')               :optional
                        | (term '+')               :repeat
                        | (term '*')               :none_or_repeat
                        | ('~' term)               :neg
                        |                           term.
term                   => ('(' _ alternation _ ')'):group
                        | ('[' _ alternation _ ']'):optional_group
                        | ('{' _ alternation _ '}'):repeat_group
                        |                           terminal
                        |                           sym.

# literals
terminal               => terminal_char | terminal_string | terminal_hex.
terminal_hex           => '0' 'x' (xdigit | (xdigit xdigit)+):hex_bytes.
sym                    => (alpha | '_') (alnum | '_')*.
terminal_char          => "'" (unescaped_c | escaped_c) "'".
unescaped_c            => printable & ~( "'" | '\\').
escaped_c              => '\\' ("'" | escape_char).
terminal_string        => '"' (unescaped_s | escaped_s)* '"'.
unescaped_s            => printable & ~('"' | '\\').
escaped_s              => '\\' ('"' | escape_char).
escape_char            => 'a' | 'b' | 'f' | 'n' | 'r' | 't' | 'v' | '\\' | '/'
                               | esc_hex | esc_u4 | esc_U8.
esc_hex                => ('x' | 'X') xdigit [ xdigit ].
esc_u4                 => 'u' xdigit xdigit xdigit xdigit.
esc_U8                 => 'U' xdigit xdigit xdigit xdigit xdigit xdigit xdigit xdigit.

# directives
directive              => ('@' _ sym:directive_name _):directive_token
                           ( (sep sym (sep sym)*):directive_cmd )*
                           [ __ dir_pair (_ ';' _ dir_pair)* ] _ '.'.
sep                    => '-' | '_' | __.
dir_pair               => dir_list [ _ ':' _ dir_list ].
dir_list               => dir_arg (_ ',' _ dir_arg)*.
# the negation keeps a run of words and strings out of dir_arg, so the words
# stay directive_cmd and a string stays a separate argument
dir_arg                => tree_path | dir_sym | terminal_string
                        | treemr_pattern & ~(pat_word (pat_space+ pat_word)+).
pat_word               => dir_sym | terminal_string.
tree_path              => dir_sym _ '>' _ dir_sym (_ '>' _ dir_sym)*.
dir_sym                => (alpha | '_' | '*') (alnum | '_' | '*')*.
treemr_pattern         => pat_unit (pat_space* pat_unit)*.
pat_unit               => terminal_string | terminal_char | pat_char.
pat_char               => printable & ~(space | ',' | '.' | ':' | ';' | '#' | '"' | '\'').
pat_space              => ' ' | '\t'.

# common productions
_                      => __ | null.                      # optional whitespace
__                     => space | comment | __ space | __ comment. # whitespace
comment                => '#' (printable | '\t')* ('\r' | '\n' | eof).

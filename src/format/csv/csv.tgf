# CSV grammar

# RFC 4180 uses comma, crlf and no_header
# a record ends with CRLF, and the crlf dialect also takes a bare LF
# three guard groups select the dialect:
#   separator: comma or tab
#   eol: crlf (CRLF or LF) or lf (LF only)
#   header: header or no_header

@enable productions comma, crlf, no_header.

@highlight string : escaped, non_escaped.
@highlight operator : SEP, DQUOTE.

@use char class printable.

@inline char classes, TEXTDATA, field, sep_char.
@trim DQUOTE, SEP, EOL.

file[no_header] => record ( EOL record )* [ EOL ].
file[header]    => header EOL record ( EOL record )* [ EOL ].
header        => name ( SEP name )*.
record        => field ( SEP field )*.
name          => field.
field         => escaped | non_escaped.
escaped       => DQUOTE ( TEXTDATA | sep_char | CR | LF | escaped_quote )* DQUOTE.
escaped_quote => DQUOTE '"'.
non_escaped   => TEXTDATA*.

SEP[comma]      => ','.
SEP[tab]        => '\t'.
sep_char[comma] => ','.
sep_char[tab]   => '\t'.
CR              => '\r'.
LF              => '\n'.
EOL[crlf]       => CR LF | LF.
EOL[lf]         => LF.
DQUOTE          => '"'.
TEXTDATA        => printable & ~( DQUOTE | SEP | CR | LF ).

start       => file.

# sourced by build.sh, preset.sh, and tau-lang scripts; not standalone
#
# devrc special-cases TAU_BUILD_JOBS and -G (GENERATOR). Other -D flags
# (TAU_PARSER_*, TAU_BUILD_*, etc.) are passed through DEV_CMAKE by the caller.

__devrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

is_cmake_def() {
	case "$1" in
		-D*) return 0 ;;
		*)   return 1 ;;
	esac
}

normalize_args() {
	DEV_POSITIONAL=()
	DEV_CMAKE=()
	DEV_PROGRAM=()
	VERBOSE=""
	TARGET=""
	GENERATOR=""
	GENERATOR_EXPLICIT=""
	BUILD_TYPE=""
	PRESET=""
	RUN=""
	local past_dd=false
	local args=("$@")
	local i=0 arg next
	while [[ $i -lt ${#args[@]} ]]; do
		arg="${args[$i]}"
		if $past_dd; then
			DEV_PROGRAM+=("$arg")
			((i++)) || true
			continue
		fi
		if [[ $arg == -- ]]; then
			DEV_PROGRAM+=(--)
			past_dd=true
			((i++)) || true
			continue
		fi
		if [[ $arg == -G ]]; then
			((i++)) || true
			if [[ $i -ge ${#args[@]} ]]; then
				echo "Missing value for -G" >&2
				exit 1
			fi
			GENERATOR="${args[$i]}"
			GENERATOR_EXPLICIT=1
			((i++)) || true
			continue
		fi
		if is_cmake_def "$arg"; then
			DEV_CMAKE+=("$arg")
			((i++)) || true
			continue
		fi
		case "$arg" in
			-v)
				VERBOSE="1"
				((i++)) || true
				;;
			--target)
				((i++)) || true
				if [[ $i -ge ${#args[@]} ]]; then
					echo "Missing value for --target" >&2
					exit 1
				fi
				TARGET="${args[$i]}"
				((i++)) || true
				;;
			run)
				RUN="run"
				((i++)) || true
				;;
			Debug|Release|RelWithDebInfo|Coverage)
				if [[ -n $BUILD_TYPE ]]; then
					echo "Duplicate build type: ${arg}" >&2
					exit 1
				fi
				BUILD_TYPE="$arg"
				((i++)) || true
				;;
			*)
				DEV_POSITIONAL+=("$arg")
				((i++)) || true
				;;
		esac
	done

	[[ -z $BUILD_TYPE ]] && BUILD_TYPE="Release"
	[[ -z $GENERATOR ]] && GENERATOR="Ninja"

	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		PRESET="${DEV_POSITIONAL[0]}"
	fi
}

resolve_jobs() {
	dep_entry "${DEV_CMAKE[@]}"
	local jobs
	jobs="$(dep_jobs)"
	echo "TAU_BUILD_JOBS: ${jobs}"
	# preset configure uses env; cmake --preset rejects -DTAU_BUILD_JOBS
	local filtered=() arg
	for arg in "${DEV_CMAKE[@]}"; do
		[[ $arg == -DTAU_BUILD_JOBS=* ]] && continue
		filtered+=("$arg")
	done
	DEV_CMAKE=("${filtered[@]}")
	export TAU_BUILD_JOBS="$jobs"
	export CMAKE_BUILD_PARALLEL_LEVEL="$jobs"
}

dev_entry() {
	if [[ -z "${DEV_ROOT:-}" ]]; then
		echo "devrc: DEV_ROOT not set" >&2
		exit 1
	fi
	normalize_args "$@"
	resolve_jobs
}

dev_check_no_extra_positionals() {
	local context="${1:-argument}"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		echo "Unknown ${context}: ${DEV_POSITIONAL[0]}" >&2
		exit 1
	fi
}

# A single-purpose wrapper (release.sh, debug.sh, ...) hardcodes its build
# type and forwards "$@" into build_entry/test_entry, so a caller-supplied
# build type collides with it there and surfaces as "Duplicate build type" --
# true, but blind to which wrapper caused it. Call this before forwarding,
# naming the wrapper and its fixed type so the message points at the actual
# mistake: passing a build type to a wrapper that already has one.
# Usage: dev_reject_build_type <wrapper> <fixed-type> "$@"
dev_reject_build_type() {
	local wrapper="$1" fixed_type="$2"
	shift 2
	local arg
	for arg in "$@"; do
		case "$arg" in
			Debug|Release|RelWithDebInfo|Coverage)
				echo "${wrapper} always builds ${fixed_type}; drop the '${arg}' argument" >&2
				echo "(use './dev build ${arg}' for a ${arg} build)" >&2
				exit 1
				;;
		esac
	done
}

ninja_available() {
	which ninja > /dev/null 2>&1 || which ninja-build > /dev/null 2>&1
}

# Initializes every submodule `git submodule status` reports as not yet
# checked out (a leading "-" on its status line), leaving already-initialized
# ones alone. Reads the status output via a here-string, which keeps the
# while loop out of a subshell (bash runs a pipeline's last stage in one).
git_submodules_init() {
	local status_output line submod
	status_output="$(git submodule status)"
	while IFS= read -r line; do
		[[ -z $line ]] && continue
		submod="$(awk '{print $2}' <<<"$line")"
		if [[ $line == -* ]]; then
			echo "Initializing submodule ${submod}"
			git submodule update --init --recursive "${submod}"
		else
			echo "Submodule ${submod} is already initialized"
		fi
	done <<<"$status_output"
}

build_run() {
	BUILD_DIR="build-${BUILD_TYPE}"
	echo "Building in ${BUILD_DIR} directory"

	if declare -f dev_pre_configure > /dev/null; then
		dev_pre_configure
	fi

	mkdir -p "${BUILD_DIR}"
	cd "${BUILD_DIR}"
	rm -f ./CMakeCache.txt

	if [[ $GENERATOR == Ninja ]] && ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		GENERATOR="Unix Makefiles"
	fi

	local verbose_flag=""
	if [[ $VERBOSE == 1 ]]; then
		if [[ $GENERATOR == Ninja ]]; then
			verbose_flag="-v"
		else
			verbose_flag="VERBOSE=1"
		fi
	fi

	echo "Configuring with ${GENERATOR} build system"
	cmake .. -G "${GENERATOR}" -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
		"${DEV_CMAKE[@]}"

	echo "Building with ${GENERATOR}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	echo "Target: ${TARGET}"
	local build_target=()
	if [[ -n $TARGET ]]; then
		build_target=(--target "$TARGET")
	fi
	cmake --build . "${build_target[@]}" -- -j "${TAU_BUILD_JOBS}" \
		${verbose_flag}
	local status=$?

	cd ..
	return $status
}

build_entry() {
	dev_entry "$@"
	dev_check_no_extra_positionals "build argument"
	build_run
	exit $?
}

test_entry() {
	local build_type="${1:?test_entry: build type required}"
	shift
	dev_entry "${build_type}" "$@"
	dev_check_no_extra_positionals "test argument"
	build_run || exit $?
	ctest -j "${TAU_BUILD_JOBS}" --test-dir "build-${BUILD_TYPE}" \
		--output-on-failure
	exit $?
}

preset_binary_dir() {
	case "$1" in
		release-mingw*|*-mingw-packages*)
			echo "build/release-mingw"
			;;
		debug-mingw*)
			echo "build/debug-mingw"
			;;
		relwithdebinfo*)
			echo "build/relwithdebinfo"
			;;
		*emscripten*)
			echo "build/$1"
			;;
		release-clang|release-*-clang|release-make-clang \
			|release-ninja-clang)
			echo "build/release-clang"
			;;
		debug-clang|debug-*-clang|debug-make-clang \
			|debug-ninja-clang)
			echo "build/debug-clang"
			;;
		coverage*)
			echo "build/coverage"
			;;
		debug*)
			echo "build/debug"
			;;
		release*)
			echo "build/release"
			;;
		all)
			echo "build/release"
			;;
		*)
			echo "build"
			;;
	esac
}

# cd into the build dir in a subshell, so the caller's cwd is untouched even
# if cpack fails.
run_cpack() {
	local build_dir="$1"
	( cd "${build_dir}" && cpack -C Release )
}

preset_entry() {
	dev_entry "$@"
	[[ -z $PRESET ]] && PRESET="release"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 \
			&& ${DEV_POSITIONAL[0]} == "$PRESET" ]]; then
		DEV_POSITIONAL=("${DEV_POSITIONAL[@]:1}")
	fi
	dev_check_no_extra_positionals "preset argument"

	PRESET_RUN_BIN="${PRESET_RUN_BIN:-tgf}"

	# only the configure step takes a generator or cache variables
	local generator_args=()
	if [[ ${GENERATOR_EXPLICIT:-} == 1 ]]; then
		generator_args=(-G "${GENERATOR}")
	elif ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		generator_args=(-G "Unix Makefiles")
	fi

	echo "Preset: ${PRESET}"
	echo "Run: ${RUN}"
	if [[ ${#generator_args[@]} -gt 0 || ${#DEV_CMAKE[@]} -gt 0 ]]; then
		echo "CMake args: ${generator_args[*]} ${DEV_CMAKE[*]}"
	fi

	TAU_BUILD_JOBS="${TAU_BUILD_JOBS:-1}"

	echo "Configuring with preset ${PRESET}"
	cmake --fresh --preset "${PRESET}" "${generator_args[@]}" \
		"${DEV_CMAKE[@]}"

	echo "Building with preset ${PRESET}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	local build_target=()
	if [[ -n $TARGET ]]; then
		echo "Target: ${TARGET}"
		build_target=(--target "$TARGET")
	fi
	cmake --build --preset "${PRESET}" "${build_target[@]}" \
		-- -j "${TAU_BUILD_JOBS}"
	local status=$?
	if [[ $status -ne 0 ]]; then
		echo "Build failed"
		exit $status
	fi
	echo "Preset '${PRESET}' build completed"

	if [[ $PRESET == *package* ]]; then
		local build_dir
		build_dir="$(preset_binary_dir "${PRESET}")"
		echo "Creating packages in ${build_dir} (Release)"
		run_cpack "${build_dir}"
		status=$?
		if [[ $status -ne 0 ]]; then
			echo "Packaging failed"
			exit $status
		fi
		echo "Packages created in ${build_dir}/packages"
	elif [[ $RUN == "run" ]]; then
		if [[ $PRESET == *test* ]] || [[ $PRESET == *-all ]] \
				|| [[ $PRESET == "all" ]]; then
			echo "Running tests"
			ctest --preset "${PRESET}" -j "${TAU_BUILD_JOBS}" \
				--output-on-failure
			status=$?
			if [[ $status -ne 0 ]]; then
				echo "Running tests failed"
				exit $status
			fi
			echo "All tests passed"
		else
			local build_dir run_args=("${DEV_PROGRAM[@]}")
			build_dir="$(preset_binary_dir "${PRESET}")"
			if [[ ${run_args[0]:-} == -- ]]; then
				run_args=("${run_args[@]:1}")
			fi
			"./${build_dir}/${PRESET_RUN_BIN}" "${run_args[@]}"
		fi
	fi
}

resolve_script() {
	local root="."
	if [ -d "$1" ]; then
		root="$1"; shift
	fi
	local script_name="$1"; shift
	script_name="${script_name%.sh}"

	if [ -f "${root}/scripts/${script_name}.sh" ]; then
		exec "${root}/scripts/${script_name}.sh" "$@"
	fi

	if [ -f "${root}/CMakePresets.json" ] && \
	   grep -qE "\"name\"[[:space:]]*:[[:space:]]*\"${script_name}\"" "${root}/CMakePresets.json" && \
	   [[ "$script_name" != _* ]]; then
		read -p "Use preset '${script_name}'? [Y/n] " -r REPLY
		[[ -z "$REPLY" || "$REPLY" =~ ^[Yy]([Ee][Ss])?$ ]] || exit 1
		exec "${root}/scripts/preset.sh" "$script_name" "$@"
	fi

	return 1
}

# --- dep-*.sh helpers --------------------------------------------------
#
# The dep-*.sh scripts here and in tau-lang (e.g. dep-emsdk.sh in this repo)
# each pull a handful of -D options, a --w64/--darwin/--emscripten platform
# switch, an idempotency guard, and a clone-once git checkout. dep_entry
# parses those options generically.

# Declared at load time, not only inside dep_entry, so dep_var works for a
# caller that just wants dep_shared_prefix and never parses arguments. With
# DEP_VARS undeclared, bash reads DEP_VARS[$name] as an *arithmetic* subscript
# and evaluates the variable named by $name: an exported TAU_SHARED_PREFIX=/opt/x
# then dies with "arithmetic syntax error" and dep_var returns empty instead of
# the fallback -- silently yielding an empty prefix.
declare -gA DEP_VARS=()
DEP_POSITIONAL=()
DEP_TARGET="native"

dep_entry() {
	declare -gA DEP_VARS=()
	DEP_POSITIONAL=()
	DEP_TARGET="native"
	local arg name value
	for arg in "$@"; do
		case "$arg" in
			--w64)
				DEP_TARGET="w64"
				;;
			--darwin)
				DEP_TARGET="darwin"
				;;
			--emscripten)
				DEP_TARGET="emscripten"
				;;
			-D*=*)
				name="${arg#-D}"
				name="${name%%=*}"
				value="${arg#-D"${name}"=}"
				DEP_VARS[$name]="$value"
				;;
			*)
				DEP_POSITIONAL+=("$arg")
				;;
		esac
	done
}

# An empty value falls back to the default: `-DTAU_BUILD_JOBS=` reaches here
# whenever a caller interpolates an unset variable into a -D flag, and an
# empty jobs count would otherwise expand to a bare `make -j`, i.e.
# unbounded parallelism.
dep_var() {
	local name="$1" default="${2:-}"
	if [[ -v DEP_VARS[$name] && -n "${DEP_VARS[$name]}" ]]; then
		echo "${DEP_VARS[$name]}"
	else
		echo "$default"
	fi
}

# cmake -P warns and ignores a trailing empty-string command-line argument,
# so only pass "requested" through when dep_var actually found a -D; a
# missing arg is exactly what tau-resolve.cmake treats as "none given"
# anyway.
_tau_resolve() {
	local var="$1" requested="$2"
	if [[ -n "$requested" ]]; then
		cmake -P "${__devrc_dir}/../cmake/tau-resolve.cmake" "$var" "$requested"
	else
		cmake -P "${__devrc_dir}/../cmake/tau-resolve.cmake" "$var"
	fi
}

# -D beats the environment beats ~/.tau. cmake/tau-resolve.cmake is the
# single definition of the rule; this asks it (via `cmake -P`) rather than
# restating the rule in bash, so the shell and CMake sides cannot disagree
# about where a dependency landed. Only the explicit -D value (if any) is
# passed through as "requested" -- tau-resolve.cmake itself checks the
# TAU_SHARED_PREFIX environment variable and falls back to ~/.tau.
dep_shared_prefix() {
	_tau_resolve TAU_SHARED_PREFIX "$(dep_var TAU_SHARED_PREFIX "")"
}

# -D beats the environment beats half the logical core count (rounded up,
# minimum 1). cmake/tau-resolve.cmake is the single definition of the rule;
# this asks it (via `cmake -P`) rather than restating the rule in bash, so
# the shell and CMake sides cannot disagree about how many jobs to use. Only
# the explicit -D value (if any) is passed through as "requested" --
# tau-resolve.cmake itself checks the TAU_BUILD_JOBS environment variable
# and falls back to auto-detection.
dep_jobs() {
	_tau_resolve TAU_BUILD_JOBS "$(dep_var TAU_BUILD_JOBS "")"
}

dep_done_if_exists() {
	local path="$1" label="$2"
	if [[ -e "$path" ]]; then
		echo "${path} already exists, skipping ${label}"
		exit 0
	fi
}

dep_git_source() {
	local repo="$1" dir="$2" tag="${3:-}"
	if [[ ! -d "$dir" ]]; then
		git clone "$repo" "$dir"
		cd "$dir"
		[[ -n "$tag" ]] && git checkout "$tag"
	else
		echo "${dir} already exists, skipping clone and checkout"
		cd "$dir"
	fi
}

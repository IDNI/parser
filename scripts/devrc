# sourced by build.sh, preset.sh, and tau-lang scripts; not standalone
#
# devrc special-cases TAU_BUILD_JOBS and -G (GENERATOR). Other -D flags
# (TAU_PARSER_*, TAU_BUILD_*, etc.) are passed through DEV_CMAKE by the caller.

__devrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

is_cmake_def() {
	case "$1" in
		-D*) return 0 ;;
		*)   return 1 ;;
	esac
}

normalize_args() {
	DEV_POSITIONAL=()
	DEV_CMAKE=()
	DEV_PROGRAM=()
	VERBOSE=""
	TARGET=""
	GENERATOR=""
	GENERATOR_EXPLICIT=""
	BUILD_TYPE=""
	PRESET=""
	RUN=""
	KEEP_CACHE=""
	local past_dd=false
	local args=("$@")
	local i=0 arg next
	while [[ $i -lt ${#args[@]} ]]; do
		arg="${args[$i]}"
		if $past_dd; then
			DEV_PROGRAM+=("$arg")
			((i++)) || true
			continue
		fi
		if [[ $arg == -- ]]; then
			DEV_PROGRAM+=(--)
			past_dd=true
			((i++)) || true
			continue
		fi
		if [[ $arg == -G ]]; then
			((i++)) || true
			if [[ $i -ge ${#args[@]} ]]; then
				echo "Missing value for -G" >&2
				exit 1
			fi
			GENERATOR="${args[$i]}"
			GENERATOR_EXPLICIT=1
			((i++)) || true
			continue
		fi
		if is_cmake_def "$arg"; then
			DEV_CMAKE+=("$arg")
			((i++)) || true
			continue
		fi
		case "$arg" in
			-v)
				VERBOSE="1"
				((i++)) || true
				;;
			--keep-cache)
				KEEP_CACHE="1"
				((i++)) || true
				;;
			--target)
				((i++)) || true
				if [[ $i -ge ${#args[@]} ]]; then
					echo "Missing value for --target" >&2
					exit 1
				fi
				TARGET="${args[$i]}"
				((i++)) || true
				;;
			run)
				RUN="run"
				((i++)) || true
				;;
			Debug|Release|RelWithDebInfo|Coverage|Devel)
				if [[ -n $BUILD_TYPE ]]; then
					echo "Duplicate build type: ${arg}" >&2
					exit 1
				fi
				BUILD_TYPE="$arg"
				((i++)) || true
				;;
			*)
				DEV_POSITIONAL+=("$arg")
				((i++)) || true
				;;
		esac
	done

	[[ -z $BUILD_TYPE ]] && BUILD_TYPE="Release"
	[[ -z $GENERATOR ]] && GENERATOR="Ninja"

	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		PRESET="${DEV_POSITIONAL[0]}"
	fi
}

resolve_jobs() {
	dep_entry "${DEV_CMAKE[@]}"
	local jobs
	jobs="$(dep_jobs)"
	echo "TAU_BUILD_JOBS: ${jobs}"
	# preset configure uses env; cmake --preset rejects -DTAU_BUILD_JOBS
	local filtered=() arg
	for arg in "${DEV_CMAKE[@]}"; do
		[[ $arg == -DTAU_BUILD_JOBS=* ]] && continue
		filtered+=("$arg")
	done
	DEV_CMAKE=("${filtered[@]}")
	export TAU_BUILD_JOBS="$jobs"
	export CMAKE_BUILD_PARALLEL_LEVEL="$jobs"
}

dev_entry() {
	if [[ -z "${DEV_ROOT:-}" ]]; then
		echo "devrc: DEV_ROOT not set" >&2
		exit 1
	fi
	normalize_args "$@"
	resolve_jobs
	git_submodules_init
}

dev_check_no_extra_positionals() {
	local context="${1:-argument}"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		echo "Unknown ${context}: ${DEV_POSITIONAL[0]}" >&2
		exit 1
	fi
}

# A single-purpose wrapper (release.sh, debug.sh, ...) hardcodes its build
# type and forwards "$@" into build_entry/test_entry, so a caller-supplied
# build type collides with it there and surfaces as "Duplicate build type" --
# true, but blind to which wrapper caused it. Call this before forwarding,
# naming the wrapper and its fixed type so the message points at the actual
# mistake: passing a build type to a wrapper that already has one.
# Usage: dev_reject_build_type <wrapper> <fixed-type> "$@"
dev_reject_build_type() {
	local wrapper="$1" fixed_type="$2"
	shift 2
	local arg
	for arg in "$@"; do
		case "$arg" in
			Debug|Release|RelWithDebInfo|Coverage)
				echo "${wrapper} always builds ${fixed_type}; drop the '${arg}' argument" >&2
				echo "(use './dev build ${arg}' for a ${arg} build)" >&2
				exit 1
				;;
		esac
	done
}

ninja_available() {
	which ninja > /dev/null 2>&1 || which ninja-build > /dev/null 2>&1
}

make_available() {
	which make > /dev/null 2>&1
}

# Initializes every submodule `git submodule status` reports as not yet
# checked out (a leading "-" on its status line), and offers to update ones
# checked out at a commit other than the one HEAD pins (a leading "+"), which
# otherwise builds against the wrong sources. Reads the status on fd 3, which
# keeps the while loop out of a subshell (bash runs a pipeline's last stage in
# one) and leaves stdin free for the prompt. Set TAU_SKIP_SUBMODULE_CHECK=1 to
# leave "+" submodules alone, as when co-developing one against its parent.
git_submodules_init() {
	local status_output line submod current pinned reply
	status_output="$(git submodule status)"
	while IFS= read -r line <&3; do
		[[ -z $line ]] && continue
		submod="$(awk '{print $2}' <<<"$line")"
		case $line in
		-*)
			echo "Initializing submodule ${submod}"
			git submodule update --init --recursive "${submod}"
			;;
		+*)
			[[ -n ${TAU_SKIP_SUBMODULE_CHECK:-} ]] && continue
			current="$(awk '{print $1}' <<<"$line")"
			pinned="$(git rev-parse --short=8 "HEAD:./${submod}" 2>/dev/null)"
			echo ""
			echo "Warning: submodule ${submod} is not at the commit pinned by HEAD"
			echo "  checked out: ${current:1:8}"
			echo "  pinned:      ${pinned:-unknown}"
			reply="n"
			if [ -t 0 ]; then
				read -p "Update ${submod} to the pinned commit? [Y/n] " -r reply
			fi
			if [[ -z $reply || $reply =~ ^[Yy]([Ee][Ss])?$ ]]; then
				git submodule update --init --recursive "${submod}"
			else
				echo "Leaving ${submod} as is; the build may use stale sources."
				echo "To update it yourself, run:"
				echo "  git submodule update --init --recursive ${submod}"
			fi
			echo ""
			;;
		*)
			echo "Submodule ${submod} is already initialized"
			;;
		esac
	done 3<<<"$status_output"
}

build_run() {
	BUILD_DIR="build-${BUILD_TYPE}"
	echo "Building in ${BUILD_DIR} directory"

	if declare -f dev_pre_configure > /dev/null; then
		dev_pre_configure
	fi

	mkdir -p "${BUILD_DIR}"
	cd "${BUILD_DIR}"
	rm -f ./CMakeCache.txt

	if [[ $GENERATOR == Ninja ]] && ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		GENERATOR="Unix Makefiles"
	fi

	local verbose_flag=""
	if [[ $VERBOSE == 1 ]]; then
		if [[ $GENERATOR == Ninja ]]; then
			verbose_flag="-v"
		else
			verbose_flag="VERBOSE=1"
		fi
	fi

	echo "Configuring with ${GENERATOR} build system"
	cmake .. -G "${GENERATOR}" -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
		-DTAU_BUILD_JOBS="${TAU_BUILD_JOBS}" \
		"${DEV_CMAKE[@]}"

	echo "Building with ${GENERATOR}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	echo "Target: ${TARGET}"
	local build_target=()
	if [[ -n $TARGET ]]; then
		build_target=(--target "$TARGET")
	fi
	cmake --build . "${build_target[@]}" -- -j "${TAU_BUILD_JOBS}" \
		${verbose_flag}
	local status=$?

	cd ..
	return $status
}

build_entry() {
	dev_entry "$@"
	dev_check_no_extra_positionals "build argument"
	build_run
	exit $?
}

test_entry() {
	local build_type="${1:?test_entry: build type required}"
	shift
	dev_entry "${build_type}" "$@"
	dev_check_no_extra_positionals "test argument"
	build_run || exit $?
	ctest -j "${TAU_BUILD_JOBS}" --test-dir "build-${BUILD_TYPE}" \
		--output-on-failure
	exit $?
}

preset_binary_dir() {
	case "$1" in
		release-mingw*|*-mingw-packages*)
			echo "build/release-mingw"
			;;
		debug-mingw*)
			echo "build/debug-mingw"
			;;
		release-msvc*|*-msvc-packages*)
			echo "build/release-msvc"
			;;
		debug-msvc*)
			echo "build/debug-msvc"
			;;
		relwithdebinfo*)
			echo "build/relwithdebinfo"
			;;
		*emscripten*)
			echo "build/$1"
			;;
		release-clang|release-*-clang|release-make-clang \
			|release-ninja-clang)
			echo "build/release-clang"
			;;
		debug-clang|debug-*-clang|debug-make-clang \
			|debug-ninja-clang)
			echo "build/debug-clang"
			;;
		coverage*)
			echo "build/coverage"
			;;
		devel*)
			echo "build/devel"
			;;
		debug*)
			echo "build/debug"
			;;
		release*)
			echo "build/release"
			;;
		all)
			echo "build/release"
			;;
		*)
			echo "build"
			;;
	esac
}

# cd into the build dir in a subshell, so the caller's cwd is untouched even
# if cpack fails.
run_cpack() {
	local build_dir="$1"
	if [[ -z "$build_dir" ]]; then
		echo "run_cpack: build_dir not set"
		return 1
	fi
	( cd "${build_dir}" && cpack -C Release ) || return
	# cpack stages into the package directory; only packages stay
	rm -rf "${build_dir}/packages/_CPack_Packages"
}

preset_entry() {
	dev_entry "$@"
	[[ -z $PRESET ]] && PRESET="release"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 \
			&& ${DEV_POSITIONAL[0]} == "$PRESET" ]]; then
		DEV_POSITIONAL=("${DEV_POSITIONAL[@]:1}")
	fi
	dev_check_no_extra_positionals "preset argument"

	PRESET_RUN_BIN="${PRESET_RUN_BIN:-tgf}"

	# only the configure step takes a generator or cache variables
	local generator_args=()
	if [[ ${GENERATOR_EXPLICIT:-} == 1 ]]; then
		generator_args=(-G "${GENERATOR}")
	elif ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		generator_args=(-G "Unix Makefiles")
	elif ! make_available; then
		echo "Make is not available. Using Ninja."
		generator_args=(-G "Ninja")
	fi

	echo "Preset: ${PRESET}"
	echo "Run: ${RUN}"
	if [[ ${#generator_args[@]} -gt 0 || ${#DEV_CMAKE[@]} -gt 0 ]]; then
		echo "CMake args: ${generator_args[*]} ${DEV_CMAKE[*]}"
	fi

	TAU_BUILD_JOBS="${TAU_BUILD_JOBS:-1}"

	# --keep-cache layers a preset on a finished build directory. Every
	# cache value set there before stays until a -D overrides it.
	local fresh=(--fresh)
	if [[ ${KEEP_CACHE:-} == 1 ]]; then
		fresh=()
	fi
	echo "Configuring with preset ${PRESET}"
	cmake "${fresh[@]}" --preset "${PRESET}" "${generator_args[@]}" \
		"${DEV_CMAKE[@]}"

	echo "Building with preset ${PRESET}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	local build_target=()
	if [[ -n $TARGET ]]; then
		echo "Target: ${TARGET}"
		build_target=(--target "$TARGET")
	fi
	cmake --build --preset "${PRESET}" "${build_target[@]}" \
		-- -j "${TAU_BUILD_JOBS}"
	local status=$?
	if [[ $status -ne 0 ]]; then
		echo "Build failed"
		exit $status
	fi
	echo "Preset '${PRESET}' build completed"

	if [[ $PRESET == *package* ]]; then
		local build_dir
		build_dir="$(preset_binary_dir "${PRESET}")"
		echo "Creating packages in ${build_dir} (Release)"
		run_cpack "${build_dir}"
		status=$?
		if [[ $status -ne 0 ]]; then
			echo "Packaging failed"
			exit $status
		fi
		echo "Packages created in ${build_dir}/packages"
	elif [[ $RUN == "run" ]]; then
		if [[ $PRESET == *test* ]] || [[ $PRESET == *-all ]] \
				|| [[ $PRESET == "all" ]]; then
			echo "Running tests"
			ctest --preset "${PRESET}" -j "${TAU_BUILD_JOBS}" \
				--output-on-failure
			status=$?
			if [[ $status -ne 0 ]]; then
				echo "Running tests failed"
				exit $status
			fi
			echo "All tests passed"
		else
			local build_dir run_args=("${DEV_PROGRAM[@]}")
			build_dir="$(preset_binary_dir "${PRESET}")"
			if [[ ${run_args[0]:-} == -- ]]; then
				run_args=("${run_args[@]:1}")
			fi
			"./${build_dir}/${PRESET_RUN_BIN}" "${run_args[@]}"
		fi
	fi
}

resolve_script() {
	local root="."
	if [ -d "$1" ]; then
		root="$1"; shift
	fi
	local script_name="$1"; shift
	script_name="${script_name%.sh}"

	if [ -f "${root}/scripts/${script_name}.sh" ]; then
		exec "${root}/scripts/${script_name}.sh" "$@"
	fi

	if [ -f "${root}/CMakePresets.json" ] && \
	   grep -qE "\"name\"[[:space:]]*:[[:space:]]*\"${script_name}\"" "${root}/CMakePresets.json" && \
	   [[ "$script_name" != _* ]]; then
		read -p "Use preset '${script_name}'? [Y/n] " -r REPLY
		[[ -z "$REPLY" || "$REPLY" =~ ^[Yy]([Ee][Ss])?$ ]] || exit 1
		exec "${root}/scripts/preset.sh" "$script_name" "$@"
	fi

	return 1
}

# --- dep-*.sh helpers --------------------------------------------------
#
# The dep-*.sh scripts here and in tau-lang (e.g. dep-emsdk.sh in this repo)
# each pull a handful of -D options, a -DTAU_DEP_TARGET platform value,
# an idempotency guard, and a clone-once git checkout. dep_entry
# parses those options generically.

# The build configuration and invocation live in the narrow module the
# producers hash. This driver keeps the publish side and the dist helpers,
# and is provenance, not an id input.
source "${__devrc_dir}/dep-build"

dep_vars_reset
DEP_POSITIONAL=()
DEP_TARGET="native"

dep_done_if_exists() {
	local path="$1" label="$2"
	if [[ -e "$path" ]]; then
		echo "${path} already exists, skipping ${label}"
		exit 0
	fi
}

dep_git_source() {
	local repo="$1" dir="$2" tag="${3:-}"
	if [[ ! -d "$dir" ]]; then
		git clone "$repo" "$dir"
		cd "$dir"
		[[ -n "$tag" ]] && git checkout "$tag"
	else
		echo "${dir} already exists, skipping clone and checkout"
		cd "$dir"
	fi
}

# Downloads a prebuilt package and verifies it before install. Any failure
# just returns non-zero, so the caller still has a source build to fall
# back on; this never calls exit.
dep_prebuilt() {
	local url="$1" sha256="$2" prefix="$3" marker="$4"

	if [[ -n "$(dep_var TAU_NO_PREBUILT)" || -n "${TAU_NO_PREBUILT:-}" ]]; then
		echo "TAU_NO_PREBUILT is set, skipping prebuilt download"
		return 1
	fi
	if [[ -z "$url" || -z "$sha256" ]]; then
		echo "No prebuilt URL or checksum given, skipping prebuilt download"
		return 1
	fi

	local downloader=""
	if which curl > /dev/null 2>&1; then
		downloader="curl"
	elif which wget > /dev/null 2>&1; then
		downloader="wget"
	else
		echo "Neither curl nor wget found, skipping prebuilt download"
		return 1
	fi

	local sha_tool=""
	if which sha256sum > /dev/null 2>&1; then
		sha_tool="sha256sum"
	elif which shasum > /dev/null 2>&1; then
		sha_tool="shasum"
	else
		echo "Neither sha256sum nor shasum found, skipping prebuilt download"
		return 1
	fi

	local tmp_dir
	tmp_dir="$(mktemp -d)" || { echo "mktemp failed"; return 1; }
	trap 'rm -rf "$tmp_dir"' RETURN

	local archive="${tmp_dir}/$(basename "$url")"
	echo "Downloading ${url}"
	case "$downloader" in
		curl)
			curl -fsSL -o "$archive" "$url" || { echo "Download failed"; return 1; }
			;;
		wget)
			wget -qO "$archive" "$url" || { echo "Download failed"; return 1; }
			;;
	esac

	echo "Verifying checksum"
	local actual
	if [[ "$sha_tool" == sha256sum ]]; then
		actual="$(sha256sum "$archive" | awk '{print $1}')"
	else
		actual="$(shasum -a 256 "$archive" | awk '{print $1}')"
	fi
	if [[ "$actual" != "$sha256" ]]; then
		echo "Checksum mismatch for ${url}"
		echo "  expected: ${sha256}"
		echo "  actual:   ${actual}"
		return 1
	fi

	local unpack_dir="${tmp_dir}/unpacked"
	mkdir -p "$unpack_dir"
	echo "Unpacking $(basename "$archive")"
	case "$archive" in
		*.zip)
			unzip -q "$archive" -d "$unpack_dir" || { echo "Unpack failed"; return 1; }
			;;
		*.tar.gz|*.tgz|*.tar.xz|*.tar.zst)
			tar -xf "$archive" -C "$unpack_dir" || { echo "Unpack failed"; return 1; }
			;;
		*)
			echo "Unsupported archive type: ${archive}"
			return 1
			;;
	esac

	local entries=("$unpack_dir"/*) pkg_root="$unpack_dir"
	if [[ ${#entries[@]} -eq 1 && -d "${entries[0]}" ]]; then
		pkg_root="${entries[0]}"
	fi

	if [[ ! -f "${pkg_root}/${marker}" ]]; then
		echo "Marker ${marker} not found in prebuilt package"
		return 1
	fi

	echo "Installing prebuilt package at ${prefix}"
	mkdir -p "$(dirname "$prefix")" || return 1
	rm -rf "$prefix"
	if ! mv "$pkg_root" "$prefix"; then
		echo "Failed to install prebuilt package at ${prefix}"
		rm -rf "$prefix"
		return 1
	fi
	echo "Prebuilt package installed at ${prefix}"
}

# Validate a shell variable name that dep_ensure may write to.
_tau_dep_ensure_valid_name() {
	case "$1" in
		"") return 1 ;;
		_tau_dep_ensure_*) return 1 ;;
		*[!A-Za-z0-9_]*) return 1 ;;
		[0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

# Remove the claim, staging, and field block owned by the current invocation.
_tau_dep_ensure_cleanup() {
	if [ -n "${_tau_dep_ensure_staging:-}" ]; then
		rm -rf "$_tau_dep_ensure_staging"
	fi
	if [ -n "${_tau_dep_ensure_claim:-}" ]; then
		rm -f "${_tau_dep_ensure_claim}/owner"
		rmdir "$_tau_dep_ensure_claim" 2>/dev/null
	fi
	if [ -n "${_tau_dep_ensure_block_file:-}" ]; then
		rm -f "$_tau_dep_ensure_block_file"
	fi
	_tau_dep_ensure_staging=""
	_tau_dep_ensure_claim=""
	_tau_dep_ensure_block_file=""
}

# EXIT trap for the producer subshell. It fires for a callback that calls
# exit or otherwise terminates the shell, while the caller's frame is still
# live, so the owned paths are visible. It preserves the exit status.
_tau_dep_ensure_exit_trap() {
	local _tau_dep_ensure_exit_rc=$?
	_tau_dep_ensure_cleanup
	trap - EXIT INT TERM
	exit "$_tau_dep_ensure_exit_rc"
}

# Clean up and print the verified prefix, then return from the caller.
_tau_dep_ensure_finish() {
	_tau_dep_ensure_cleanup
	trap - EXIT INT TERM
	printf '%s\n' "$1"
}

# Producer side of dep_ensure. Runs in a command-substitution subshell so its
# signal traps never touch the caller's traps. Prints the store prefix on
# stdout; everything else goes to stderr.
_tau_dep_ensure_run() {
	local _tau_dep_ensure_mode="$1" _tau_dep_ensure_dep="$2"
	local _tau_dep_ensure_block="$3" _tau_dep_ensure_producer="$4"
	shift 4
	local _tau_dep_ensure_manifest_cmake="${__devrc_dir}/../cmake/tau-manifest.cmake"
	local _tau_dep_ensure_store_cmake="${__devrc_dir}/../cmake/tau-store.cmake"
	local _tau_dep_ensure_prefix _tau_dep_ensure_claim_dir _tau_dep_ensure_block_file
	local _tau_dep_ensure_id _tau_dep_ensure_lookup _tau_dep_ensure_status
	local _tau_dep_ensure_prefix_out _tau_dep_ensure_claim _tau_dep_ensure_staging
	local _tau_dep_ensure_published _tau_dep_ensure_timeout _tau_dep_ensure_poll
	local _tau_dep_ensure_now _tau_dep_ensure_deadline
	local _tau_dep_ensure_host _tau_dep_ensure_owner_file
	local _tau_dep_ensure_owner_host _tau_dep_ensure_owner_pid
	_tau_dep_ensure_claim=""
	_tau_dep_ensure_staging=""
	_tau_dep_ensure_block_file=""
	trap 'exit 130' INT TERM
	trap '_tau_dep_ensure_exit_trap' EXIT
	if ! _tau_dep_ensure_prefix="$(dep_shared_prefix)"; then
		echo "dep_ensure: cannot resolve TAU_SHARED_PREFIX" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	if [ -z "$_tau_dep_ensure_prefix" ]; then
		echo "dep_ensure: TAU_SHARED_PREFIX resolved to an empty value" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	_tau_dep_ensure_claim_dir="${_tau_dep_ensure_prefix}/store/${_tau_dep_ensure_dep}"
	_tau_dep_ensure_host="$(uname -n)"
	_tau_dep_ensure_block_file="$(mktemp "${TMPDIR:-/tmp}/tau-dep-block.XXXXXX")" || {
		echo "dep_ensure: cannot create a temporary field block" >&2
		_tau_dep_ensure_cleanup
		return 1
	}
	printf '%s\n' "$_tau_dep_ensure_block" > "$_tau_dep_ensure_block_file" || {
		echo "dep_ensure: cannot write the temporary field block" >&2
		_tau_dep_ensure_cleanup
		return 1
	}
	if ! _tau_dep_ensure_id="$(cmake -P "$_tau_dep_ensure_manifest_cmake" \
			input-id-file "$_tau_dep_ensure_block_file")"; then
		echo "dep_ensure: cannot compute an input id for ${_tau_dep_ensure_dep}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	if ! _tau_dep_ensure_lookup="$(cmake -P "$_tau_dep_ensure_store_cmake" lookup \
			"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id")"; then
		echo "dep_ensure: integrity failure for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	_tau_dep_ensure_status="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '1p')"
	if [ "$_tau_dep_ensure_status" = "hit" ]; then
		_tau_dep_ensure_prefix_out="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '2p')"
		_tau_dep_ensure_finish "$_tau_dep_ensure_prefix_out"
		return 0
	fi
	if [ "$_tau_dep_ensure_status" != "miss" ]; then
		echo "dep_ensure: unexpected lookup result for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	# Read on a miss, before building: a producer first tries the remote store,
	# then builds. An absent or failed remote is not an error, so configure
	# falls through to the build. Consumer mode reads only the local store.
	if [ "$_tau_dep_ensure_mode" = "producer" ] && [ -n "${TAU_STORE_REMOTE:-}" ]; then
		if "${__devrc_dir}/store-remote.sh" pull "$_tau_dep_ensure_prefix" \
				"${_tau_dep_ensure_dep}/${_tau_dep_ensure_id}" >&2; then
			if ! _tau_dep_ensure_lookup="$(cmake -P "$_tau_dep_ensure_store_cmake" lookup \
					"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id")"; then
				echo "dep_ensure: integrity failure for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
				_tau_dep_ensure_cleanup
				return 1
			fi
			_tau_dep_ensure_status="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '1p')"
			if [ "$_tau_dep_ensure_status" = "hit" ]; then
				_tau_dep_ensure_prefix_out="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '2p')"
				_tau_dep_ensure_finish "$_tau_dep_ensure_prefix_out"
				return 0
			fi
		else
			echo "dep_ensure: ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id} is not on ${TAU_STORE_REMOTE}; building it" >&2
		fi
	fi
	if [ "$_tau_dep_ensure_mode" = "consumer" ]; then
		echo "dep_ensure: ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id} is not in the LOCAL store (consumer mode)" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	mkdir -p "$_tau_dep_ensure_claim_dir" || {
		echo "dep_ensure: cannot create ${_tau_dep_ensure_claim_dir}" >&2
		_tau_dep_ensure_cleanup
		return 1
	}
	_tau_dep_ensure_timeout="${TAU_DEP_CLAIM_TIMEOUT:-300}"
	_tau_dep_ensure_poll="${TAU_DEP_CLAIM_POLL:-1}"
	case "$_tau_dep_ensure_timeout" in ''|*[!0-9]*) _tau_dep_ensure_timeout=300 ;; esac
	case "$_tau_dep_ensure_poll" in ''|*[!0-9]*) _tau_dep_ensure_poll=1 ;; esac
	[ "$_tau_dep_ensure_poll" -lt 1 ] && _tau_dep_ensure_poll=1
	_tau_dep_ensure_now="$(date +%s)"
	_tau_dep_ensure_deadline=$((_tau_dep_ensure_now + _tau_dep_ensure_timeout))
	while :; do
		if mkdir "${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim" 2>/dev/null; then
			_tau_dep_ensure_claim="${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim"
			if ! printf '%s %s\n' "$_tau_dep_ensure_host" "${BASHPID:-$(sh -c 'echo $PPID')}" \
					> "${_tau_dep_ensure_claim}/owner"; then
				echo "dep_ensure: cannot write the claim owner file for ${_tau_dep_ensure_claim}" >&2
				_tau_dep_ensure_cleanup
				return 1
			fi
			break
		fi
		# A claim from another host, or one with no owner file yet, is live.
		_tau_dep_ensure_owner_file="${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim/owner"
		if [ -f "$_tau_dep_ensure_owner_file" ]; then
			read -r _tau_dep_ensure_owner_host _tau_dep_ensure_owner_pid \
				< "$_tau_dep_ensure_owner_file"
			if [ "$_tau_dep_ensure_owner_host" = "$_tau_dep_ensure_host" ] \
					&& [ -n "$_tau_dep_ensure_owner_pid" ] \
					&& ! kill -0 "$_tau_dep_ensure_owner_pid" 2>/dev/null; then
				rm -f "$_tau_dep_ensure_owner_file"
				rmdir "${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim" 2>/dev/null
				continue
			fi
		fi
		if ! _tau_dep_ensure_lookup="$(cmake -P "$_tau_dep_ensure_store_cmake" lookup \
				"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id")"; then
			echo "dep_ensure: integrity failure for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
			_tau_dep_ensure_cleanup
			return 1
		fi
		_tau_dep_ensure_status="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '1p')"
		if [ "$_tau_dep_ensure_status" = "hit" ]; then
			_tau_dep_ensure_prefix_out="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '2p')"
			_tau_dep_ensure_finish "$_tau_dep_ensure_prefix_out"
			return 0
		fi
		_tau_dep_ensure_now="$(date +%s)"
		if [ "$_tau_dep_ensure_now" -ge "$_tau_dep_ensure_deadline" ]; then
			echo "dep_ensure: timed out after ${_tau_dep_ensure_timeout}s waiting for the producer claim ${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim; if that claim is stale, remove it with: rm -r ${_tau_dep_ensure_claim_dir}/${_tau_dep_ensure_id}.claim" >&2
			_tau_dep_ensure_cleanup
			return 1
		fi
		sleep "$_tau_dep_ensure_poll"
	done
	# The claim is ours. Recheck in case another producer published meanwhile.
	if ! _tau_dep_ensure_lookup="$(cmake -P "$_tau_dep_ensure_store_cmake" lookup \
			"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id")"; then
		echo "dep_ensure: integrity failure for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	_tau_dep_ensure_status="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '1p')"
	if [ "$_tau_dep_ensure_status" = "hit" ]; then
		_tau_dep_ensure_prefix_out="$(printf '%s\n' "$_tau_dep_ensure_lookup" | sed -n '2p')"
		_tau_dep_ensure_finish "$_tau_dep_ensure_prefix_out"
		return 0
	fi
	if ! _tau_dep_ensure_staging="$(dep_build_staging \
			"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id")"; then
		echo "dep_ensure: cannot create a staging entry for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	if ! dep_build_producer "$_tau_dep_ensure_staging" "$_tau_dep_ensure_producer" "$@" 1>&2; then
		echo "dep_ensure: producer failed for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	# Fail closed: a package carrying a build, staging, store, or home path is not
	# publishable, so no consumer ever resolves one.
	if ! "${__devrc_dir}/audit-store-paths.sh" \
			"$_tau_dep_ensure_staging/prefix" >&2; then
		echo "dep_ensure: producer left an absolute build, staging, store, or home path in ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	if ! cmake -P "$_tau_dep_ensure_manifest_cmake" manifest \
			"$_tau_dep_ensure_staging/manifest.json" "$_tau_dep_ensure_id" \
			"$_tau_dep_ensure_block_file" "$_tau_dep_ensure_staging/prefix" >/dev/null; then
		echo "dep_ensure: cannot write the manifest for ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	if ! _tau_dep_ensure_published="$(cmake -P "$_tau_dep_ensure_store_cmake" publish \
			"$_tau_dep_ensure_prefix" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_id" \
			"$_tau_dep_ensure_staging")"; then
		echo "dep_ensure: cannot publish ${_tau_dep_ensure_dep} ${_tau_dep_ensure_id}" >&2
		_tau_dep_ensure_cleanup
		return 1
	fi
	_tau_dep_ensure_finish "$_tau_dep_ensure_published"
	return 0
}

# Ensure a dependency package is in the LOCAL store and set <out-var> to its
# prefix. MODE is "producer" or "consumer".
#
#   dep_ensure <out-var> <mode> <dep> <field-block> <producer> [args...]
#
# <field-block> is a newline-separated list of key=value fields. <producer> is a
# shell function called as <producer> <staging-prefix> [args...]; it must
# populate <staging-prefix>. A verified hit sets the out variable and never
# calls the producer. A clean miss in consumer mode is an error. A clean miss in
# producer mode builds into a unique sibling staging entry, writes the
# complete-tree manifest, publishes atomically, and sets the out variable. A
# partial, corrupt, or digest-invalid entry is an error and is never rebuilt.
#
# A producer claim under the dependency directory serializes cold starts: the
# winner writes "<hostname> <subshell pid>" to <claim>/owner, and a waiter
# removes the claim only when that pid is dead on its own host, else it polls.
dep_ensure() {
	if [ "$#" -lt 5 ]; then
		echo "dep_ensure: usage: dep_ensure <out-var> <producer|consumer> <dep> <field-block> <producer> [args...]" >&2
		return 2
	fi
	local _tau_dep_ensure_out="$1" _tau_dep_ensure_mode="$2" _tau_dep_ensure_dep="$3"
	local _tau_dep_ensure_block="$4" _tau_dep_ensure_producer="$5"
	shift 5
	if ! _tau_dep_ensure_valid_name "$_tau_dep_ensure_out"; then
		echo "dep_ensure: output variable is not a safe name: '${_tau_dep_ensure_out}'" >&2
		return 2
	fi
	case "$_tau_dep_ensure_mode" in
		producer|consumer) ;;
		*)
			echo "dep_ensure: mode must be producer or consumer: '${_tau_dep_ensure_mode}'" >&2
			return 2
			;;
	esac
	local _tau_dep_ensure_result
	if ! _tau_dep_ensure_result="$(_tau_dep_ensure_run \
			"$_tau_dep_ensure_mode" "$_tau_dep_ensure_dep" "$_tau_dep_ensure_block" \
			"$_tau_dep_ensure_producer" "$@")"; then
		return 1
	fi
	printf -v "$_tau_dep_ensure_out" '%s' "$_tau_dep_ensure_result"
	return 0
}

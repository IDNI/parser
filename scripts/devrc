# sourced by build.sh, preset.sh, and tau-lang scripts; not standalone
#
# devrc special-cases TAU_BUILD_JOBS and -G (GENERATOR). Other -D flags
# (TAU_PARSER_*, TAU_BUILD_*, etc.) are passed through DEV_CMAKE by the caller.

__devrc_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

is_cmake_def() {
	case "$1" in
		-D*) return 0 ;;
		*)   return 1 ;;
	esac
}

normalize_args() {
	DEV_POSITIONAL=()
	DEV_CMAKE=()
	DEV_PROGRAM=()
	VERBOSE=""
	TARGET=""
	GENERATOR=""
	GENERATOR_EXPLICIT=""
	BUILD_TYPE=""
	PRESET=""
	RUN=""
	local past_dd=false
	local args=("$@")
	local i=0 arg next
	while [[ $i -lt ${#args[@]} ]]; do
		arg="${args[$i]}"
		if $past_dd; then
			DEV_PROGRAM+=("$arg")
			((i++)) || true
			continue
		fi
		if [[ $arg == -- ]]; then
			DEV_PROGRAM+=(--)
			past_dd=true
			((i++)) || true
			continue
		fi
		if [[ $arg == -G ]]; then
			((i++)) || true
			if [[ $i -ge ${#args[@]} ]]; then
				echo "Missing value for -G" >&2
				exit 1
			fi
			GENERATOR="${args[$i]}"
			GENERATOR_EXPLICIT=1
			((i++)) || true
			continue
		fi
		if is_cmake_def "$arg"; then
			DEV_CMAKE+=("$arg")
			((i++)) || true
			continue
		fi
		case "$arg" in
			-v)
				VERBOSE="1"
				((i++)) || true
				;;
			--target)
				((i++)) || true
				if [[ $i -ge ${#args[@]} ]]; then
					echo "Missing value for --target" >&2
					exit 1
				fi
				TARGET="${args[$i]}"
				((i++)) || true
				;;
			run)
				RUN="run"
				((i++)) || true
				;;
			Debug|Release|RelWithDebInfo|Coverage)
				if [[ -n $BUILD_TYPE ]]; then
					echo "Duplicate build type: ${arg}" >&2
					exit 1
				fi
				BUILD_TYPE="$arg"
				((i++)) || true
				;;
			*)
				DEV_POSITIONAL+=("$arg")
				((i++)) || true
				;;
		esac
	done

	[[ -z $BUILD_TYPE ]] && BUILD_TYPE="Release"
	[[ -z $GENERATOR ]] && GENERATOR="Ninja"

	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		PRESET="${DEV_POSITIONAL[0]}"
	fi
}

resolve_jobs() {
	dep_entry "${DEV_CMAKE[@]}"
	local requested jobs
	requested="$(dep_var TAU_BUILD_JOBS "${TAU_BUILD_JOBS:-0}")"
	jobs="$(dep_jobs)"
	if [[ $requested -eq 0 ]]; then
		echo "TAU_BUILD_JOBS: ${jobs} (half of available cores)"
	fi
	# preset configure uses env; cmake --preset rejects -DTAU_BUILD_JOBS
	local filtered=() arg
	for arg in "${DEV_CMAKE[@]}"; do
		[[ $arg == -DTAU_BUILD_JOBS=* ]] && continue
		filtered+=("$arg")
	done
	DEV_CMAKE=("${filtered[@]}")
	export TAU_BUILD_JOBS="$jobs"
	export CMAKE_BUILD_PARALLEL_LEVEL="$jobs"
}

dev_entry() {
	if [[ -z "${DEV_ROOT:-}" ]]; then
		echo "devrc: DEV_ROOT not set" >&2
		exit 1
	fi
	normalize_args "$@"
	resolve_jobs
}

dev_check_no_extra_positionals() {
	local context="${1:-argument}"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 ]]; then
		echo "Unknown ${context}: ${DEV_POSITIONAL[0]}" >&2
		exit 1
	fi
}

ninja_available() {
	which ninja > /dev/null 2>&1 || which ninja-build > /dev/null 2>&1
}

build_run() {
	BUILD_DIR="build-${BUILD_TYPE}"
	echo "Building in ${BUILD_DIR} directory"

	if declare -f dev_pre_configure > /dev/null; then
		dev_pre_configure
	fi

	mkdir -p "${BUILD_DIR}"
	cd "${BUILD_DIR}"
	rm -f ./CMakeCache.txt

	if [[ $GENERATOR == Ninja ]] && ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		GENERATOR="Unix Makefiles"
	fi

	local verbose_flag=""
	if [[ $VERBOSE == 1 ]]; then
		if [[ $GENERATOR == Ninja ]]; then
			verbose_flag="-v"
		else
			verbose_flag="VERBOSE=1"
		fi
	fi

	echo "Configuring with ${GENERATOR} build system"
	cmake .. -G "${GENERATOR}" -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
		"${DEV_CMAKE[@]}"

	echo "Building with ${GENERATOR}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	echo "Target: ${TARGET}"
	local build_target=()
	if [[ -n $TARGET ]]; then
		build_target=(--target "$TARGET")
	fi
	cmake --build . "${build_target[@]}" -- -j "${TAU_BUILD_JOBS}" \
		${verbose_flag}
	local status=$?

	cd ..
	return $status
}

build_entry() {
	dev_entry "$@"
	dev_check_no_extra_positionals "build argument"
	build_run
	exit $?
}

test_entry() {
	local build_type="${1:?test_entry: build type required}"
	shift
	dev_entry "${build_type}" "$@"
	dev_check_no_extra_positionals "test argument"
	build_run || exit $?
	ctest -j "${TAU_BUILD_JOBS}" --test-dir "build-${BUILD_TYPE}" \
		--output-on-failure
	exit $?
}

preset_binary_dir() {
	case "$1" in
		release-mingw*|*-mingw-packages*)
			echo "build/release-mingw"
			;;
		debug-mingw*)
			echo "build/debug-mingw"
			;;
		relwithdebinfo*)
			echo "build/relwithdebinfo"
			;;
		emscripten*)
			echo "build/emscripten"
			;;
		release-clang|release-*-clang|release-make-clang \
			|release-ninja-clang)
			echo "build/release-clang"
			;;
		debug-clang|debug-*-clang|debug-make-clang \
			|debug-ninja-clang)
			echo "build/debug-clang"
			;;
		coverage*)
			echo "build/coverage"
			;;
		debug*)
			echo "build/debug"
			;;
		release*)
			echo "build/release"
			;;
		all)
			echo "build/release"
			;;
		*)
			echo "build"
			;;
	esac
}

preset_entry() {
	dev_entry "$@"
	[[ -z $PRESET ]] && PRESET="release"
	if [[ ${#DEV_POSITIONAL[@]} -gt 0 \
			&& ${DEV_POSITIONAL[0]} == "$PRESET" ]]; then
		DEV_POSITIONAL=("${DEV_POSITIONAL[@]:1}")
	fi
	dev_check_no_extra_positionals "preset argument"

	PRESET_RUN_BIN="${PRESET_RUN_BIN:-tgf}"

	# only the configure step takes a generator or cache variables
	local generator_args=()
	if [[ ${GENERATOR_EXPLICIT:-} == 1 ]]; then
		generator_args=(-G "${GENERATOR}")
	elif ! ninja_available; then
		echo "Ninja is not available. Falling back to make."
		generator_args=(-G "Unix Makefiles")
	fi

	echo "Preset: ${PRESET}"
	echo "Run: ${RUN}"
	if [[ ${#generator_args[@]} -gt 0 || ${#DEV_CMAKE[@]} -gt 0 ]]; then
		echo "CMake args: ${generator_args[*]} ${DEV_CMAKE[*]}"
	fi

	TAU_BUILD_JOBS="${TAU_BUILD_JOBS:-1}"

	echo "Configuring with preset ${PRESET}"
	cmake --fresh --preset "${PRESET}" "${generator_args[@]}" \
		"${DEV_CMAKE[@]}"

	echo "Building with preset ${PRESET}"
	echo "Parallel jobs: ${TAU_BUILD_JOBS}"
	cmake --build --preset "${PRESET}" -- -j "${TAU_BUILD_JOBS}"
	local status=$?
	if [[ $status -ne 0 ]]; then
		echo "Build failed"
		exit $status
	fi
	echo "Preset '${PRESET}' build completed"

	if [[ $PRESET == *package* ]]; then
		local build_dir
		build_dir="$(preset_binary_dir "${PRESET}")"
		echo "Creating packages in ${build_dir} (Release)"
		( cd "${build_dir}" && cpack -C Release )
		status=$?
		if [[ $status -ne 0 ]]; then
			echo "Packaging failed"
			exit $status
		fi
		echo "Packages created in ${build_dir}/packages"
	elif [[ $RUN == "run" ]]; then
		if [[ $PRESET == *test* ]] || [[ $PRESET == *-all ]] \
				|| [[ $PRESET == "all" ]]; then
			echo "Running tests"
			ctest --preset "${PRESET}" -j "${TAU_BUILD_JOBS}" \
				--output-on-failure
			status=$?
			if [[ $status -ne 0 ]]; then
				echo "Running tests failed"
				exit $status
			fi
			echo "All tests passed"
		else
			local build_dir run_args=("${DEV_PROGRAM[@]}")
			build_dir="$(preset_binary_dir "${PRESET}")"
			if [[ ${run_args[0]:-} == -- ]]; then
				run_args=("${run_args[@]:1}")
			fi
			"./${build_dir}/${PRESET_RUN_BIN}" "${run_args[@]}"
		fi
	fi
}

resolve_script() {
	local root="."
	if [ -d "$1" ]; then
		root="$1"; shift
	fi
	local script_name="$1"; shift
	script_name="${script_name%.sh}"

	if [ -f "${root}/scripts/${script_name}.sh" ]; then
		exec "${root}/scripts/${script_name}.sh" "$@"
	fi

	if [ -f "${root}/CMakePresets.json" ] && \
	   grep -qE "\"name\"[[:space:]]*:[[:space:]]*\"${script_name}\"" "${root}/CMakePresets.json" && \
	   [[ "$script_name" != _* ]]; then
		read -p "Use preset '${script_name}'? [Y/n] " -r REPLY
		[[ -z "$REPLY" || "$REPLY" =~ ^[Yy]([Ee][Ss])?$ ]] || exit 1
		exec "${root}/scripts/preset.sh" "$script_name" "$@"
	fi

	return 1
}

# --- dep-*.sh helpers --------------------------------------------------
#
# dep-cvc5.sh, dep-boost.sh and dep-emsdk.sh each pull a handful of -D
# options, a --w64/--darwin platform switch, an idempotency guard, and a
# clone-once git checkout. dep_entry parses those options generically.

# Declared at load time, not only inside dep_entry, so dep_var works for a
# caller that just wants dep_shared_prefix and never parses arguments. With
# DEP_VARS undeclared, bash reads DEP_VARS[$name] as an *arithmetic* subscript
# and evaluates the variable named by $name: an exported TAU_SHARED_PREFIX=/opt/x
# then dies with "arithmetic syntax error" and dep_var returns empty instead of
# the fallback -- silently yielding an empty prefix.
declare -gA DEP_VARS=()
DEP_POSITIONAL=()
DEP_TARGET="native"

dep_entry() {
	declare -gA DEP_VARS=()
	DEP_POSITIONAL=()
	DEP_TARGET="native"
	local arg name value
	for arg in "$@"; do
		case "$arg" in
			--w64)
				DEP_TARGET="w64"
				;;
			--darwin)
				DEP_TARGET="darwin"
				;;
			-D*=*)
				name="${arg#-D}"
				name="${name%%=*}"
				value="${arg#-D"${name}"=}"
				DEP_VARS[$name]="$value"
				;;
			*)
				DEP_POSITIONAL+=("$arg")
				;;
		esac
	done
}

# An empty value falls back to the default: `-DTAU_BUILD_JOBS=` reaches here
# whenever the caller interpolates an unset variable (CMakeLists.txt passes
# -DTAU_BUILD_JOBS=${TAU_BUILD_JOBS}), and an empty jobs count would expand to
# a bare `make -j`, i.e. unbounded parallelism.
dep_var() {
	local name="$1" default="${2:-}"
	if [[ -v DEP_VARS[$name] && -n "${DEP_VARS[$name]}" ]]; then
		echo "${DEP_VARS[$name]}"
	else
		echo "$default"
	fi
}

# -D beats the environment beats ~/.tau, mirroring how dep_jobs treats
# TAU_BUILD_JOBS. This is the single definition of the rule: cmake asks this
# function rather than restating it (see cmake/tau-shared-prefix.cmake), so
# the shell and CMake sides cannot disagree about where a dependency landed.
dep_shared_prefix() {
	dep_var TAU_SHARED_PREFIX "${TAU_SHARED_PREFIX:-${HOME}/.tau}"
}

# -D beats the environment beats half the logical core count (rounded up,
# minimum 1). This is the single definition of the rule: resolve_jobs and
# cmake/tau-build-jobs.cmake both ask this function rather than restating it,
# so the shell and CMake sides cannot disagree about how many jobs to use.
dep_jobs() {
	local jobs
	jobs="$(dep_var TAU_BUILD_JOBS "${TAU_BUILD_JOBS:-0}")"
	if [[ $jobs -eq 0 ]]; then
		# message() with no mode writes to stderr, and it is always the
		# last line the script prints, warning or not.
		jobs=$(cmake -P "${__devrc_dir}/../cmake/processor-counter.cmake" \
			2>&1 | tail -n 1)
		[[ $jobs =~ ^[0-9]+$ ]] || jobs=1
		jobs=$(( (jobs + 1) / 2 ))
		[[ $jobs -lt 1 ]] && jobs=1
	fi
	echo "$jobs"
}

dep_done_if_exists() {
	local path="$1" label="$2"
	if [[ -e "$path" ]]; then
		echo "${path} already exists, skipping ${label}"
		exit 0
	fi
}

dep_git_source() {
	local repo="$1" dir="$2" tag="${3:-}"
	if [[ ! -d "$dir" ]]; then
		git clone "$repo" "$dir"
		cd "$dir"
		[[ -n "$tag" ]] && git checkout "$tag"
	else
		echo "${dir} already exists, skipping clone and checkout"
		cd "$dir"
	fi
}
